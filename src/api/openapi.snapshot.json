{
  "openapi": "3.0.0",
  "info": { "title": "Orbit API", "version": "1.0.0" },
  "servers": [{ "url": "/" }],
  "paths": {
    "/api/orbit-types": {
      "get": { "operationId": "getPublishedList", "parameters": [{ "name": "maxHeight", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "maximum": 40000 } }], "responses": { "200": { "description": "Published orbit types", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/OrbitType" } } } } } } },
      "post": { "operationId": "createDraft", "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "image": { "type": "string", "format": "binary" }, "video": { "type": "string", "format": "binary" } } } } } }, "responses": { "201": { "description": "Draft created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrbitType" } } } } } }
    },
    "/api/orbit-types/feed": { "get": { "operationId": "getFeed", "parameters": [{ "name": "id", "in": "query", "required": false, "schema": { "type": "integer" } }, { "name": "next", "in": "query", "required": false, "schema": { "type": "boolean" } }], "responses": { "200": { "description": "One published orbit", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrbitType" } } } } } } },
    "/api/orbit-types/draft": { "get": { "operationId": "getDraft", "responses": { "200": { "description": "Current draft", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrbitType" } } } } } } },
    "/api/orbit-types/draft/publish": { "put": { "operationId": "publishDraft", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "description": { "type": "string", "nullable": true }, "height": { "type": "number", "nullable": true }, "inclination": { "type": "number", "nullable": true } } } } } }, "responses": { "200": { "description": "Published draft", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrbitType" } } } } } } },
    "/api/orbit-types/{id}": { "delete": { "operationId": "deletePublished", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Deleted orbit", "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "integer" }, "status": { "type": "string" } } } } } } } } },
    "/api/orbit-types/{id}/like": { "post": { "operationId": "setLike", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["liked"], "properties": { "liked": { "type": "integer", "enum": [0, 1] } } } } } }, "responses": { "200": { "description": "Like updated", "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "integer" }, "liked": { "type": "integer", "enum": [0, 1] }, "likeCount": { "type": "integer" } } } } } } } } }
  },
  "components": { "schemas": { "OrbitType": { "type": "object", "required": ["id", "name", "description", "height", "inclination", "image", "video", "status", "creatorId", "createdAt", "formedAt", "isCreator", "likeCount", "isLiked"], "properties": { "id": { "type": "integer" }, "name": { "type": "string" }, "description": { "type": "string", "nullable": true }, "height": { "type": "number", "nullable": true }, "inclination": { "type": "number", "nullable": true }, "image": { "type": "string" }, "video": { "type": "string" }, "status": { "type": "string" }, "creatorId": { "type": "integer" }, "createdAt": { "type": "string", "format": "date-time" }, "formedAt": { "type": "string", "format": "date-time", "nullable": true }, "isCreator": { "type": "integer", "enum": [0, 1] }, "likeCount": { "type": "integer" }, "isLiked": { "type": "integer", "enum": [0, 1] } } } } }
}
